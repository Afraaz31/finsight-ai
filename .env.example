# Copy this file to .env and fill in real values. .env is git-ignored: never commit it.

# Google Gemini (free tier) - get a key at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemma-4-31b-it

# SEC requires an identifying User-Agent with a real contact email
SEC_USER_AGENT=FinSightAI your_email@example.com

# Optional local backup model (install Ollama, then: ollama pull llama3.2:3b)
OLLAMA_ENABLED=false
OLLAMA_MODEL=llama3.2:3b
OLLAMA_URL=http://localhost:11434

# Optional
# FINSIGHT_API_URL=http://127.0.0.1:8000      # where the Streamlit UI finds the API
# EMBEDDING_MODEL=all-MiniLM-L6-v2            # sentence-transformers model
